# Database
POSTGRES_DB=cyimage
POSTGRES_USER=cyimage
POSTGRES_PASSWORD=cyimage123

DATABASE_URL=postgresql+asyncpg://cyimage:cyimage123@localhost:5432/cyimage
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-secret-key-in-production

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Environment
APP_ENV=development

# WeChat Pay (leave empty for development)
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_APIV3_KEY=
WECHAT_CERT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PUBLIC_KEY_PATH=
WECHAT_PUBLIC_KEY_ID=
WECHAT_NOTIFY_URL=https://www.zjcypc.com/api/pay/notify
WECHAT_REFUND_NOTIFY_URL=https://www.zjcypc.com/api/pay/refund/notify

# Server
SERVER_BASE_URL=http://localhost:8000

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CyImagePro
SMTP_USE_SSL=true

# Payment limits
PAYMENT_MIN_TOTAL_USD=1.0
PAYMENT_MAX_TOTAL_USD=1000.0
PAYMENT_MIN_PER_ITEM_USD=0.01

# PackyAPI pricing sync
PACKYAPI_PRICING_URL=https://www.packyapi.com/api/pricing
PACKYAPI_SYNC_INTERVAL_MINUTES=60
PACKYAPI_MARKUP_PERCENT=15.0

# PackyAPI Master Tokens (server-side only, never sent to client storage)
# Legacy single token (fallback if separate tokens not configured)
PACKYAPI_MASTER_TOKEN=
PACKYAPI_BASE_URL=https://www.packyapi.com

# Image-specific token (GPT-Image-2)
PACKYAPI_IMAGE_MASTER_TOKEN=
PACKYAPI_IMAGE_BASE_URL=https://www.packyapi.com


# V4：Image2 单模型计费
TRIAL_CREDIT_USD=1.0
RESERVATION_TTL_HOURS=2
